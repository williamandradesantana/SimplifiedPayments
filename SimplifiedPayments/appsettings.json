{
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "SimplifiedPayments": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SimplifiedPayments",
    "Audience": "SimplifiedPayments.Clients",
    "ExpirationMinutes": 60
  },
  "ExternalServices": {
    "AuthorizerUrl": "https://util.devi.tools/api/v2/authorize",
    "NotifierUrl": "https://util.devi.tools/api/v1/notify"
  }
}
